# .env.example - скопируй на сервер как .env.production

# Xvfb конфигурация (запускается внутри контейнера на :99)
XVFB_DISPLAY=:99
XVFB_SCREEN=0 1920x1080x24
DISPLAY=:99

# Приложение
LOG_LEVEL=INFO
OUTPUT_PATH=/app/output
TARGET_URL=https://sleep-well-creatives.com
VIEWPORT_WIDTH=1920
VIEWPORT_HEIGHT=1080
LOAD_TIMEOUT=60000
RENDER_TIMEOUT=5000
BROWSER_FULLSCREEN=true

# Smart cursor (авто-поиск интерактивных элементов и hover-эффектов)
SMART_CURSOR_ENABLED=true
SMART_CURSOR_TIMEOUT=45000
SMART_CURSOR_MAX_TARGETS=24
SMART_CURSOR_HOVER_MIN_MS=450
SMART_CURSOR_HOVER_MAX_MS=1300
SMART_CURSOR_ENTRY_CLICK_ENABLED=true
SMART_CURSOR_ENTRY_CLICK_ATTEMPTS=2
SMART_CURSOR_SCROLL_TO_END=true
SMART_CURSOR_BOTTOM_STABLE_ROUNDS=3
SMART_CURSOR_SCROLL_SPEED=1.15
SMART_CURSOR_SCROLL_PAUSE_MIN_MS=40
SMART_CURSOR_SCROLL_PAUSE_MAX_MS=95
SMART_CURSOR_INPAGE_CLICK_ENABLED=true
SMART_CURSOR_INPAGE_CLICK_PROBABILITY=0.28
SMART_CURSOR_ALLOW_INTERNAL_NAV_CLICK=true

# Ресурсы
MEMORY_LIMIT=2G
CPU_SHARES=1024
