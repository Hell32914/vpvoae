# .env.example - скопируй на сервер как .env.production

# Xvfb конфигурация
XVFB_DISPLAY=:100
XVFB_SCREEN=0 1920x1080x24
DISPLAY=:100

# Приложение
LOG_LEVEL=INFO
OUTPUT_PATH=/app/output
TARGET_URL=https://sleep-well-creatives.com
VIEWPORT_WIDTH=1920
VIEWPORT_HEIGHT=1080
LOAD_TIMEOUT=60000
RENDER_TIMEOUT=5000

# Ресурсы
MEMORY_LIMIT=2G
CPU_SHARES=1024
