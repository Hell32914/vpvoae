# Xvfb конфигурация (запускается внутри контейнера на :99)
XVFB_DISPLAY=:99
XVFB_SCREEN=0 1920x1080x24
DISPLAY=:99

# Приложение
LOG_LEVEL=INFO
OUTPUT_PATH=/app/output
# Любой целевой сайт. Для каждого запуска можно переопределять.
TARGET_URL=https://www.sendpotion.com/
VIEWPORT_WIDTH=1920
VIEWPORT_HEIGHT=1080
XVFB_COLOR_DEPTH=24
LOAD_TIMEOUT=60000
RENDER_TIMEOUT=5000
BROWSER_FULLSCREEN=true
BROWSER_APP_MODE=true
BROWSER_PERFORMANCE_MODE=true
VISIBLE_CURSOR_ENABLED=true

# Smart cursor (авто-поиск интерактивных элементов и hover-эффектов)
SMART_CURSOR_ENABLED=true
# default = текущий умный режим, scroll_only = только спуск вниз без hover/click/nav
SMART_CURSOR_MODE=scroll_only
# Для scroll_only: пауза на каждой новой секции/CTA и замедление после неё
SMART_CURSOR_SCROLL_ONLY_SECTION_PAUSE_MS=500
SMART_CURSOR_SCROLL_ONLY_SECTION_SLOWDOWN_FACTOR=0.58
SMART_CURSOR_SCROLL_ONLY_SECTION_SLOWDOWN_ROUNDS=2
SMART_CURSOR_TIMEOUT=360000
# 0 = без лимита целей (пока не дойдем до низа или не выйдем по timeout)
SMART_CURSOR_MAX_TARGETS=0
SMART_CURSOR_HOVER_MIN_MS=220
SMART_CURSOR_HOVER_MAX_MS=760
SMART_CURSOR_HOVER_VISIBLE_RATIO=0.60
SMART_CURSOR_CLICK_VISIBLE_RATIO=0.46
SMART_CURSOR_MIN_VISIBILITY_CLARITY=0.42
SMART_CURSOR_CLICK_SEQUENCE_MAX_STEPS=2
SMART_CURSOR_CLICK_SEQUENCE_RADIUS_FACTOR=0.30
SMART_CURSOR_STRICT_INTERACTIONS_PER_SCROLL=2
SMART_CURSOR_STRICT_STALL_TIMEOUT_MS=10000
SMART_CURSOR_ENTRY_CLICK_ENABLED=true
SMART_CURSOR_ENTRY_CLICK_ATTEMPTS=3
SMART_CURSOR_SCROLL_TO_END=true
SMART_CURSOR_BOTTOM_STABLE_ROUNDS=4
SMART_CURSOR_SCROLL_SPEED=1.25
SMART_CURSOR_SCROLL_PAUSE_MIN_MS=24
SMART_CURSOR_SCROLL_PAUSE_MAX_MS=70
SMART_CURSOR_SCROLL_FINISH_TIMEOUT_MS=45000
SMART_CURSOR_STRICT_TOP_TO_BOTTOM=true
SMART_CURSOR_ALWAYS_DESCEND=true
SMART_CURSOR_STRICT_ALLOW_CLICKS=false
SMART_CURSOR_REQUIRE_BOTTOM=true
SMART_CURSOR_REQUIRE_BOTTOM_MAX_MS=900000
# Включите true, если нужно видеть в логах причину "дно достигнуто / не достигнуто"
SMART_CURSOR_BOTTOM_DEBUG=true
# Проход по верхним вкладкам (Home/About/Work/...) до основного спуска в STRICT-режиме
SMART_CURSOR_NAV_TABS_VISIT_ENABLED=true
SMART_CURSOR_NAV_TABS_MAX_VISITS=10
SMART_CURSOR_NAV_TAB_SCROLL_TIMEOUT_MS=17000
SMART_CURSOR_INPAGE_CLICK_ENABLED=true
SMART_CURSOR_INPAGE_CLICK_PROBABILITY=0.12
SMART_CURSOR_ALLOW_INTERNAL_NAV_CLICK=false

# Скриншот (не влияет на видеозапись)
SCREENSHOT_ENABLED=false
SCREENSHOT_TIMEOUT_MS=5000

# Предзагрузка: сайт открывается ДО старта FFmpeg-записи и выдерживается минимум N секунд.
# По умолчанию запись стартует через 30 секунд после открытия сайта.
PRELOAD_TIME_S=30
# Сколько миллисекунд ждать полной загрузки контента и исчезновения прелоадера
# перед стартом движения курсора (в момент самой записи)
PRELOAD_WAIT_MS=20000

# Видеозапись: автокроп верхней полосы (браузерный UI, если вдруг остается в X11)
FFMPEG_AUTO_CROP_BROWSER_UI=true
# 0 = использовать авто-определение верхнего crop в entrypoint.sh
FFMPEG_CROP_TOP=0
# 0 = скрыть системный X11 курсор (используем видимый оверлейный курсор из браузера)
FFMPEG_DRAW_MOUSE=0
FFMPEG_FRAMERATE=15
FFMPEG_PRESET=ultrafast
FFMPEG_CRF=24
FFMPEG_THREADS=2
# 10 = ffmpeg в более низком приоритете, чтобы браузер не лагал
FFMPEG_NICE_LEVEL=10

# Ресурсы
# Рекомендованные лимиты для тяжелых WebGL-сайтов
MEMORY_LIMIT=6G
MEMSWAP_LIMIT=8G
SHM_SIZE=4G
CPU_SHARES=2048
